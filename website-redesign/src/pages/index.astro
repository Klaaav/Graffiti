---
import BaseLayout from '../layouts/BaseLayout.astro';
import EffectsStage from '../components/EffectsStage';
import GallerySection from '../components/GallerySection';
import HeroMotion from '../components/HeroMotionAlt.astro';
import ModelStage from '../components/ModelStage';
import FeedbackForm from '../components/FeedbackForm';
import DownloadModal from '../components/DownloadModal.astro';
---

<BaseLayout>
  <header class="signal-bar">
    <a class="signal-brand" href="#top" aria-label="Graffiti home">
      <img src="/logos/logo_transparent.png" alt="Graffiti" />
      <span>GRAFFITI<span class="brand-descriptor"> / WALLPAPER SYSTEM</span></span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#effects">Effects</a>
      <a href="#gallery">Gallery</a>
      <a href="#model">3D mode</a>
      <a class="button button-small" href="#download">Get the app <b aria-hidden="true">↗</b></a>
    </nav>
  </header>

  <main id="top">
    <section class="hero-transmission" aria-labelledby="hero-title">
      <div class="hero-rail" aria-hidden="true"><span>01</span><span>GRAFFITI</span><span>2026</span></div>
      <div class="hero-brand-zone">
        <div class="signal-kicker"><span>A product of Klaav</span></div>
        <img class="hero-logo" src="/logos/logo_transparent.png" alt="Graffiti" />
        <h1 id="hero-title">Make the desktop<br /><span>move.</span></h1>
      </div>
      <div class="hero-detail-zone">
        <p class="hero-copy">Bring the wallpaper you already own. Graffiti adds cursor-reactive effects, a shape-based Gallery, and 3D wallpapers—all running locally on Windows.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#effects">Explore effects <b aria-hidden="true">↓</b></a>
          <a class="button button-ghost" href="#download">How to get it <b aria-hidden="true">↘</b></a>
        </div>
      </div>
      <HeroMotion />
      <div class="hero-bottom"><span>Scroll to wake the signal</span><span class="hero-line" aria-hidden="true"></span><span>Local by design</span></div>
    </section>

    <section class="statement-band" aria-label="Graffiti product principles">
      <p><span>NO MARKETPLACE</span><strong>Your wallpapers stay yours.</strong></p>
      <p><span>NO CLOUD REQUIRED</span><strong>The effects respond on your machine.</strong></p>
      <p><span>ONE IMAGE</span><strong>Six ways to make it move.</strong></p>
    </section>

    <EffectsStage client:visible />
    <GallerySection client:visible />
    <ModelStage client:visible />

    <section id="download" class="utility-section download-module">
      <div class="utility-index">07 / ACCESS</div>
      <div class="utility-main"><h2>Your desktop is<br /><span>waiting.</span></h2><p class="signal-kicker">GET GRAFFITI</p></div>
      <div class="utility-detail"><p>A lightweight Windows app for turning the wallpaper you already own into a responsive desktop scene.</p><DownloadModal /><small>Version 1.0 is available now; planned upgrades are listed alongside the current installer.</small></div>
    </section>

    <section id="feedback" class="utility-section feedback-module">
      <div class="feedback-decor" aria-hidden="true">
        <i class="feedback-tile feedback-tile-frame"></i>
        <i class="feedback-tile feedback-tile-bar"></i>
        <i class="feedback-tile feedback-tile-corner"></i>
      </div>
      <div class="utility-index">08 / RETURN SIGNAL</div>
      <div class="utility-main"><h2>Leave a<br /><span>trace.</span></h2><p class="signal-kicker">FEEDBACK CHANNEL</p><p class="utility-intro">Questions, rough edges, an effect you want to try. Send a note from the page.</p></div>
      <FeedbackForm client:visible />
    </section>
  </main>

  <footer class="signal-footer">
    <a class="signal-brand" href="#top"><img src="/logos/logo_transparent.png" alt="Graffiti" /><span>GRAFFITI / WALLPAPER SYSTEM</span></a>
    <p>A product of Klaav.</p>
    <div><a href="#effects">Effects</a><a href="#gallery">Gallery</a><a href="#download">Download</a><a href="#feedback">Feedback</a></div>
  </footer>
</BaseLayout>
