<img class="site-cursor" src="/cursor/taming-arrow-cursor.png" alt="" aria-hidden="true" />

<script>
  const cursor = document.querySelector<HTMLElement>('.site-cursor');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (cursor && finePointer.matches && !reducedMotion.matches) {
    let frame = 0;
    let x = -100;
    let y = -100;
    const render = () => {
      cursor.style.transform = `translate3d(${x}px, ${y}px, 0) scale(var(--cursor-scale))`;
      frame = 0;
    };
    window.addEventListener('pointermove', (event) => {
      x = event.clientX;
      y = event.clientY;
      if (!frame) frame = requestAnimationFrame(render);
    }, { passive: true });
    /* Use event delegation on the body so dynamically-rendered React controls
       (effect queue buttons, feedback form elements, etc.) get the cursor highlight
       without needing per-element listeners. */
    document.body.addEventListener('pointerover', (event) => {
      const target = event.target instanceof Element
        ? event.target.closest('a, button, select, textarea, input, [role="button"], [role="tab"]')
        : null;
      if (target) cursor.classList.add('is-over-control');
    });
    document.body.addEventListener('pointerout', (event) => {
      const target = event.target instanceof Element
        ? event.target.closest('a, button, select, textarea, input, [role="button"], [role="tab"]')
        : null;
      if (target) cursor.classList.remove('is-over-control');
    });
  }
</script>
