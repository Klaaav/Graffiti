<div class="hero-alt">
  <a class="hero-alt-stage" href="#effects" aria-label="Explore Graffiti effects">
    <div class="hero-alt-meta"><span>001</span><span>CURSOR REACTIVE</span></div>
    <div class="hero-alt-wordmark" aria-hidden="true">
      <span class="hero-alt-wordmark-echo">GRAFFITI</span>
      <span class="hero-alt-wordmark-main">GRAFFITI</span>
    </div>
    <div class="hero-alt-grid" aria-hidden="true"></div>
    <div class="hero-alt-reticle" aria-hidden="true"><i></i></div>
    <div class="hero-alt-node hero-alt-node-frame" aria-hidden="true"><i></i></div>
    <div class="hero-alt-node hero-alt-node-diamond" aria-hidden="true"><i></i></div>
    <div class="hero-alt-node hero-alt-node-bars" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="hero-alt-node hero-alt-node-bracket" aria-hidden="true"><i></i></div>
    <div class="hero-alt-trace" aria-hidden="true"><i></i></div>
    <div class="hero-alt-marker hero-alt-marker-one" aria-hidden="true">01</div>
    <div class="hero-alt-marker hero-alt-marker-two" aria-hidden="true">MOVE</div>
    <div class="hero-alt-baseline" aria-hidden="true"><span>IMAGE</span><i></i><span>RESPONSE</span></div>
  </a>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('.hero-alt-stage');
  if (stage) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let frame = 0;
    let x = 0;
    let y = 0;
    let bounds: DOMRect | undefined;
    const render = () => {
      stage.style.setProperty('--alt-x', x.toFixed(3));
      stage.style.setProperty('--alt-y', y.toFixed(3));
      frame = 0;
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
    const reset = () => { x = 0; y = 0; bounds = undefined; schedule(); };
    stage.addEventListener('pointerenter', () => { bounds = stage.getBoundingClientRect(); });
    stage.addEventListener('pointermove', (event) => {
      if (reducedMotion.matches || !finePointer.matches) return;
      bounds ??= stage.getBoundingClientRect();
      x = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width) * 2 - 1));
      y = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height) * 2 - 1));
      schedule();
    });
    stage.addEventListener('pointerleave', reset);
    stage.addEventListener('blur', reset);
    window.addEventListener('resize', reset, { passive: true });
  }
</script>
