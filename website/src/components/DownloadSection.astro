---
---
<section id="download" class="relative w-full py-24 md:py-32 bg-[#0B0A08] border-t border-[var(--color-border)] snap-start">
  <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center flex flex-col items-center">
    
    <h2 class="font-display text-5xl md:text-6xl text-[var(--color-primary)] mb-6">
      Download Graffiti
    </h2>
    <p class="font-sans text-lg text-[var(--color-secondary)] max-w-2xl mb-12">
      Native Windows 10/11 application. Zero cloud dependencies.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-6">
      {/* Primary CTA (v1.1) */}
      <a 
        href="#" 
        class="group relative inline-flex items-center justify-center px-10 py-4 border border-[var(--color-accent)] font-sans text-sm uppercase tracking-widest text-[var(--color-primary)] overflow-hidden transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0B0A08] focus-visible:ring-[var(--color-accent)]"
      >
        {/* Fill Wipe Background */}
        <div class="absolute inset-0 bg-gradient-to-r from-[#D4AF6A] to-[#F4E2B8] transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out" />
        
        <span class="relative z-10 flex items-center group-hover:text-[#0B0A08] transition-colors duration-300">
          Download v1.1
        </span>
      </a>

      {/* Disabled CTA */}
      <div class="px-10 py-4 border border-[var(--color-secondary)]/30 font-sans text-sm uppercase tracking-widest text-[var(--color-secondary)]/50 cursor-not-allowed">
        Coming Soon
      </div>
    </div>
    
  </div>
</section>
