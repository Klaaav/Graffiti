---
import SectionWrapper from './SectionWrapper.astro';

const roadmapItems = [
  {
    date: 'Q4 2026',
    title: 'Steam Workshop Integration',
    description: 'Share your custom wallpaper compositions with the community. Browse, download, and rate creations from other users — all within the app.',
    status: 'planned'
  },
  {
    date: 'Q1 2027',
    title: 'Advanced Shader API',
    description: 'Write your own HLSL shaders and plug them directly into the effect pipeline. Full access to cursor position, time, and wallpaper textures.',
    status: 'planned'
  },
  {
    date: 'Q2 2027',
    title: 'Multi-Monitor Synchronization',
    description: 'Run coordinated effects across multiple displays. A single gravity lens that spans two screens, or independent effects per monitor — your choice.',
    status: 'planned'
  }
];
---

<SectionWrapper id="roadmap" className="bg-[var(--color-surface)] border-t border-[var(--color-border)] py-24 md:py-32">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="mb-16 md:mb-24">
      <h2 class="font-display text-4xl md:text-5xl font-medium tracking-tight mb-4 text-[var(--color-primary)]">
        Future Plans
      </h2>
      <p class="font-sans text-xl text-[var(--color-secondary)]">
        What's next for the engine.
      </p>
    </div>

    <div class="relative">
      {/* Vertical Connecting Line */}
      <div class="absolute left-[11px] md:left-[19px] top-4 bottom-4 w-px bg-[var(--color-border)]"></div>

      <div class="space-y-16">
        {roadmapItems.map((item) => (
          <div class="relative flex gap-8 md:gap-12 group">

            {/* Timeline Node — square, not rounded */}
            <div class="relative z-10 flex-shrink-0 mt-1.5 md:mt-2">
              <div class="w-6 h-6 md:w-10 md:h-10 bg-[var(--color-background)] border-2 border-[var(--color-border)] flex items-center justify-center group-hover:border-[var(--color-primary)] transition-colors duration-300">
                <div class="w-2 h-2 md:w-3 md:h-3 bg-[var(--color-secondary)] group-hover:bg-[var(--color-primary)] transition-colors duration-300"></div>
              </div>
            </div>

            {/* Content */}
            <div class="flex-1 pb-4">
              <span class="font-mono text-sm uppercase tracking-widest text-[var(--color-accent)] mb-2 block">
                {item.date}
              </span>
              <h3 class="font-display text-2xl md:text-3xl font-medium text-[var(--color-primary)] mb-4">
                {item.title}
              </h3>
              <p class="font-sans text-lg text-[var(--color-secondary)] leading-relaxed max-w-2xl">
                {item.description}
              </p>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</SectionWrapper>
