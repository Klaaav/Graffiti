---
interface Props {
  id?: string;
  className?: string;
  isHero?: boolean;
}

const { id, className = '', isHero = false } = Astro.props;
---

<section 
  id={id} 
  class:list={[
    "relative w-full overflow-hidden flex flex-col justify-center items-center snap-start",
    isHero ? "min-h-screen pt-32 pb-24" : "py-24 md:py-32",
    className
  ]}
>
  <div class="relative w-full max-w-7xl mx-auto px-6 md:px-12 z-10">
    <slot />
  </div>
</section>
