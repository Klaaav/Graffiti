---
// Footer containing Contact info and social links
---

<footer class="bg-[#050505] border-t border-[var(--color-border)]/50 pt-16 pb-8 snap-start">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      
      {/* Brand & Parent Attribution */}
      <div class="flex flex-col items-center md:items-start space-y-2">
        <span class="font-display text-2xl font-bold tracking-tight text-white">Graffiti</span>
        <span class="font-mono text-xs uppercase tracking-widest text-[var(--color-secondary)]">A Klaaav Product</span>
      </div>

      {/* Contact Link */}
      <div class="text-center">
        <a href="mailto:hello@klaaav.com" class="font-sans text-lg text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors focus:outline-none focus-visible:underline">
          hello@klaaav.com
        </a>
      </div>

      {/* Social / Link Icons Placeholder */}
      <div class="flex items-center space-x-6">
        <a href="#" class="text-[var(--color-secondary)] hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded-sm" aria-label="Twitter">
