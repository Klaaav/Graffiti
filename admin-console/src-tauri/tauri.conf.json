{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GraffitiAdmin",
  "version": "1.0.0",
  "identifier": "com.klaaav.graffiti.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Graffiti Admin",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../ui/src-tauri/icons/32x32.png",
      "../../ui/src-tauri/icons/128x128.png",
      "../../ui/src-tauri/icons/128x128@2x.png",
      "../../ui/src-tauri/icons/icon.icns",
      "../../ui/src-tauri/icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../../ui/src-tauri/icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
